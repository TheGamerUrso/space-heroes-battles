--- !u!114 &7571453289936520658
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1155719464663044819}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a07e969b0bc8e5499ee207fe91f2f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TutorialWindow: {fileID: 10452577809350312}
  Title: {fileID: 1155719463916585868}
  Description: {fileID: 1155719465136702850}
  TutorailItemsToShow:
  - Name: Coin
    Description: Main currency of the game, collect them and buy usefull uprades in
      the main menu
    prefabItem: {fileID: 1156771232436224752}
  - Name: Health Pack
    Description: Regain some of your lost health
    prefabItem: {fileID: 1156570438812141691}
  - Name: 'Powerpack '
    Description: Increases Firerate when collected and when 5 are collected gain new
      weapon. Caution if damage occur upgrade returns to previous and need to be collected
      again.
    prefabItem: {fileID: 1157388015978845744}
  - Name: Shieldpack
    Description: Enable Shield on the ship. Protects ship from attacks . While shield
      is active you don't loose any Upgrades when Hit.
    prefabItem: {fileID: 1157314448889743192}
  - Name: Super Active
    Description: When S is Flashing your super is ready to use. Unlease devasted attack
      to your enemies by double tap the screen or click the big 'S'
    prefabItem: {fileID: 4785041501332338782}
  - Name: 'Upgrade '
    Description: Every Time you Collect Power Pack you get one upgrade and when all
      is filled you earn an upgrade. every one upgrade increases your fire rate and
      5 you earn the next weapon.
    prefabItem: {fileID: 8115505413230117788}
  - Name: Multiplier
    Description: 'Every time you kill an enemy you earn One Kill multiplier. Means
      the score you earn is multiplied by the ammount of kills you are without getting
      hit. This number goes up till 4. '
    prefabItem: {fileID: 3320981380440511928}
