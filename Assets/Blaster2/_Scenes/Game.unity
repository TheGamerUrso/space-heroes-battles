--- !u!114 &7055920258222519810
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1797338721864524035}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a07e969b0bc8e5499ee207fe91f2f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TutorialView: {fileID: 638873575392333176}
  Title: {fileID: 1797338719891763292}
  Description: {fileID: 1797338721390868050}
  TutorailItemsToShow:
  - Name: Coin
    Description: Main currency of the game, collect them and buy usefull uprades in the main menu
    prefabItem: {fileID: 1797338720801679037}
  - Name: Health Pack
    Description: Regain some of your lost health
    prefabItem: {fileID: 1797338721502154990}
  - Name: 'Powerpack '
    Description: Increases Firerate when collected and when 5 are collected gain new weapon. Caution if damage occur upgrade returns to previous and need to be collected again.
    prefabItem: {fileID: 1797338720858508177}
  - Name: Shieldpack
    Description: Enable Shield on the ship. Protects ship from attacks . While shield is active you don't loose any Upgrades when Hit.
    prefabItem: {fileID: 1797338720493469119}
  - Name: Super Active
    Description: When S is Flashing your super is ready to use. Unlease devasted attack to your enemies by double tap the screen or click the big 'S'
    prefabItem: {fileID: 5377156483230108558}
  - Name: 'Upgrade '
    Description: Every Time you Collect Power Pack you get one upgrade and when all is filled you earn an upgrade. every one upgrade increases your fire rate and 5 you earn the next weapon.
    prefabItem: {fileID: 8671838988562313292}
  - Name: Multiplier
    Description: 'Every time you kill an enemy you earn One Kill multiplier. Means the score you earn is multiplied by the ammount of kills you are without getting hit. This number goes up till 4. '
    prefabItem: {fileID: 2805426226064467560}
  gameController: {fileID: 2233804167081751954}
